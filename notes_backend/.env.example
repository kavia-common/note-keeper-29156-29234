# Example environment file for notes_backend
# Copy to .env and adjust values for your environment.

# Debug mode: use false in production
DEBUG=true

# Secret key: change this in production
SECRET_KEY=change-me-in-prod

# Database selection:
# Option A: Single DATABASE_URL (recommended)
# Postgres example:
DATABASE_URL=postgres://user:password@notes_database:5432/notes
# SQLite examples (uncomment one if you want to force SQLite via URL):
# DATABASE_URL=sqlite:///absolute/path/to/db.sqlite3
# DATABASE_URL=sqlite:///:memory:

# Option B: Discrete Postgres variables (used if DATABASE_URL is not set)
# POSTGRES_DB=notes
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=notes_database
# POSTGRES_PORT=5432
